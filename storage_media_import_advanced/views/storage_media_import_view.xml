<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="storage_media_import_form_view" model="ir.ui.view">
        <field name="name">storage.media.import.form</field>
        <field name="model">storage.media.import</field>
        <field name="arch" type="xml">
            <form string="Import storage media">
                <header>
                    <button
                        class="oe_highlight"
                        string="Import medias"
                        name="action_import"
                        type="object"
                        states="new"
                    />
                    <button
                        class="oe_highlight"
                        string="Import medias again"
                        name="action_import"
                        type="object"
                        states="done"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div
                        class="oe_button_box"
                        name="active_button_box"
                        attrs="{'invisible': [('id','=',False)]}"
                    >
                    </div>
                    <field name="id" invisible="1" />
                    <group name="main">
                        <group name="file" string="Source">
                            <field
                                name="source_type"
                                widget="radio"
                                options="{'horizontal': True}"
                            />
                            <field name="filename" invisible="1" />
                            <field
                                name="file_csv"
                                filename="filename"
                                attrs="{
                                        'required': [('source_type', '!=', 'external_storage')],
                                        'invisible': [('source_type', '=', 'external_storage')]
                                    }"
                            />
                            <field name="filename_zip" invisible="1" />
                            <field
                                name="source_zipfile"
                                filename="filename_zip"
                                attrs="{
                                        'required': [('source_type', '=', 'zip_file')],
                                        'invisible': [('source_type', '!=', 'zip_file')]
                                    }"
                            />
                            <field
                                name="source_storage_backend_id"
                                attrs="{
                                        'required': [('source_type', '=', 'external_storage')],
                                        'invisible': [('source_type', '!=', 'external_storage')],
                                    }"
                            />
                            <field
                                name="external_csv_path"
                                attrs="{
                                        'required': [('source_type', '=', 'external_storage')],
                                        'invisible': [('source_type', '!=', 'external_storage')],
                                    }"
                            />
                            <field name="csv_delimiter" />
                        </group>
                        <group name="destination" string="Destination">
                            <field name="storage_backend_id" />
                        </group>
                        <group name="mapping" string="Column Mapping">
                            <field name="csv_column_name" string="Filename" />
                            <field name="csv_column_media_type" string="Media Type" />
                            <field name="csv_column_file_path" string="File Path" />
                        </group>
                        <group name="options" string="Options">
                            <field name="overwrite" />
                            <field name="create_missing_media_types" />
                            <field name="chunk_size" />
                        </group>
                    </group>
                    <separator string="Report" />
                    <field name="report_html" nolabel="1" />
                    <label for="done_on" />
                    <field name="done_on" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="storage_media_import_tree_view" model="ir.ui.view">
        <field name="name">storage.media.import.tree</field>
         <field name="model">storage.media.import</field>
        <field name="arch" type="xml">
            <tree
                string="Import storage media"
                decoration-warning="state == 'scheduled'"
                decoration-success="state == 'done'"
            >
                <field name="storage_backend_id" />
                <field name="source_type" />
                <field name="state" />
                <field name="done_on" />
            </tree>
        </field>
    </record>

    <record id="import_media_action" model="ir.actions.act_window">
        <field name="name">Import Product Media</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">storage.media.import</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="storage_media_import_tree_view" />
    </record>

    <menuitem
        id="menu_storage_media_import"
        name="Import Storage media"
        parent="storage_backend.menu_storage"
        action="import_media_action"
        sequence="60"
    />

</odoo>
